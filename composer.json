{
    "name": "abu-abbas/error-definition-framework",
    "description": "Framework untuk mendefinisikan, mengelola, dan membagikan error secara terstruktur dan konsisten.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Edf\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Edf\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Edf\\Laravel\\ErrorDefinitionServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "post-install-cmd": [
            "@install-hooks"
        ],
        "post-update-cmd": [
            "@install-hooks"
        ],
        "install-hooks": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
