{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/abu-abbas/error-definition-framework/resources/schemas/publish-request.v1.json",
  "title": "EDF publish request, version 1",
  "type": "object",
  "required": ["application", "revision", "catalog"],
  "properties": {
    "application": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "catalog": {
      "$ref": "error-catalog.v1.json"
    }
  }
}
